const router = require('express').Router();
const jwt = require('jsonwebtoken');
const Gig = require('../models/Gig');
const Order = require('../models/Order');
const Review = require('../models/Review');
const GigView = require('../models/GigView');
const WorkSession = require('../models/WorkSession');
const User = require('../models/User');
const connectDB = require('../db');

const secret = () => process.env.JWT_SECRET || 'tumhara_super_secret_key_yahan_hoga';

function currentUserId(req) {
  const token = req.cookies?.token || req.headers.authorization?.replace(/^Bearer\s+/i, '');
  try {
    return token ? jwt.verify(token, secret()).userId : null;
  } catch {
    return null;
  }
}

function startOfDay(date = new Date()) {
  const d = new Date(date);
  d.setHours(0, 0, 0, 0);
  return d;
}

function daysAgo(n) {
  const d = startOfDay();
  d.setDate(d.getDate() - n);
  return d;
}

function round(value, digits = 2) {
  const factor = 10 ** digits;
  return Math.round((Number(value) || 0) * factor) / factor;
}

router.get('/seller', async (req, res) => {
  console.log("Cookies:", req.cookies);
  console.log("Header Cookie:", req.headers.cookie);

  const sellerId = currentUserId(req);
  console.log("Seller ID:", sellerId);
  try {
    const sellerId = currentUserId(req);
    if (!sellerId) return res.status(401).json({ success: false, error: 'Authentication required' });

    await connectDB();
    const seller = await User.findOne({ id: sellerId }).lean();
    const gigs = await Gig.find({ sellerId }).lean();
    const gigIds = gigs.map((gig) => gig.id);

    const [viewsToday, viewsWeek, viewsMonth, uniqueVisitors, orders, reviews, sessions] = await Promise.all([
      GigView.countDocuments({ sellerId, viewedAt: { $gte: startOfDay() } }),
      GigView.countDocuments({ sellerId, viewedAt: { $gte: daysAgo(7) } }),
      GigView.countDocuments({ sellerId, viewedAt: { $gte: daysAgo(30) } }),
      GigView.distinct('visitorId', { sellerId, viewedAt: { $gte: daysAgo(30) } }),
      Order.find({ sellerId }).lean(),
      Review.find({ sellerId }).select('rating').lean(),
      WorkSession.find({ sellerId }).lean(),
    ]);
    console.log('Seller ID:', sellerId);
    console.log("Current Seller:", sellerId);
    console.log('Views Today:', viewsToday);
    console.log('Views Week:', viewsWeek);
    console.log('Views Month:', viewsMonth);
    console.log('Unique Visitors:', uniqueVisitors.length);


    const totalOrders = orders.length;
    const completedOrders = orders.filter((o) => o.status === 'completed').length;
    const cancelledOrders = orders.filter((o) => o.status === 'cancelled').length;
    const revenue = orders
      .filter((o) => o.status === 'completed')
      .reduce((sum, o) => sum + (Number(o.price) || 0), 0);

    const averageRating = reviews.length
      ? round(reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length, 1)
      : round(seller?.rating || 0, 1);

    // Conversion rate: completed/paid orders vs unique gig views (30 day window).
    const uniqueVisitorCount = uniqueVisitors.length;
    const conversionRate = uniqueVisitorCount > 0 ? round((totalOrders / uniqueVisitorCount) * 100, 2) : 0;

    // Work analytics
    const now = new Date();
    const completedSessions = sessions.filter((s) => !s.isRunning);
    const totalMinutes = completedSessions.reduce((sum, s) => sum + (s.totalMinutes || 0), 0)
      + sessions.filter((s) => s.isRunning).reduce((sum, s) => sum + (now - new Date(s.startedAt)) / 60000, 0);

    const todayMinutes = sessions
      .filter((s) => new Date(s.startedAt) >= startOfDay())
      .reduce((sum, s) => sum + (s.isRunning ? (now - new Date(s.startedAt)) / 60000 : (s.totalMinutes || 0)), 0);

    const weekMinutes = sessions
      .filter((s) => new Date(s.startedAt) >= daysAgo(7))
      .reduce((sum, s) => sum + (s.isRunning ? (now - new Date(s.startedAt)) / 60000 : (s.totalMinutes || 0)), 0);

    return res.json({
      success: true,
      gigAnalytics: {
        viewsToday,
        viewsWeek,
        viewsMonth,
        uniqueVisitors: uniqueVisitorCount,
        totalGigs: gigs.length,
        totalOrders,
        conversionRate,
        gigBreakdown: gigs.map((gig) => ({ id: gig.id, title: gig.title, views: 0 })),
        gigIds,
      },
      sellerPerformance: {
        totalOrders,
        completedOrders,
        cancelledOrders,
        revenue: round(revenue, 2),
        averageRating,
        responseRate: seller?.sellerMetrics?.responseRate ?? seller?.responseRate ?? 100,
        responseTime: seller?.responseTime || seller?.sellerMetrics?.responseTime || '1 hour',
        level: seller?.level || seller?.sellerMetrics?.level || 'New Seller',
        completionRate: totalOrders ? round((completedOrders / totalOrders) * 100, 1) : 0,
      },
      workAnalytics: {
        lastActive: seller?.lastSeen || null,
        totalSessions: sessions.length,
        runningSession: sessions.find((s) => s.isRunning) || null,
        totalHours: round(totalMinutes / 60, 1),
        todayHours: round(todayMinutes / 60, 1),
        weeklyHours: round(weekMinutes / 60, 1),
      },
    });
  } catch (error) {
    return res.status(500).json({ success: false, error: error.message || 'Unable to load analytics' });
  }
});

router.get('/gig/:gigId', async (req, res) => {
  try {
    await connectDB();
    const gigId = req.params.gigId;
    const [viewsToday, viewsWeek, viewsMonth, uniqueVisitors, orders] = await Promise.all([
      GigView.countDocuments({ gigId, viewedAt: { $gte: startOfDay() } }),
      GigView.countDocuments({ gigId, viewedAt: { $gte: daysAgo(7) } }),
      GigView.countDocuments({ gigId, viewedAt: { $gte: daysAgo(30) } }),
      GigView.distinct('visitorId', { gigId }),
      Order.find({ gigId }).lean(),
    ]);
    const uniqueVisitorCount = uniqueVisitors.length;
    const totalOrders = orders.length;
    return res.json({
      success: true,
      gigAnalytics: {
        viewsToday,
        viewsWeek,
        viewsMonth,
        uniqueVisitors: uniqueVisitorCount,
        totalOrders,
        conversionRate: uniqueVisitorCount > 0 ? round((totalOrders / uniqueVisitorCount) * 100, 2) : 0,
      },
    });
  } catch (error) {
    return res.status(500).json({ success: false, error: error.message || 'Unable to load gig analytics' });
  }
});

module.exports = router;